import { ComboBox, ScrollView } from "std-widgets.slint";
import { Measured, Model, TestJob, TestProblem } from "contract.slint";
import { AppSlider, Body, Breadcrumb, Caption, Card, DeviceTile, ExperimentalTag, FluentButton, Group, Icon, InfoBar, LevelBar, ModeGroup, ResultText, Reveal, Row, SwitchControl, TestButton } from "components.slint";
import { Grid, Surface, Type } from "theme.slint";
import { Texts } from "texts.slint";

// A page. What does not fit under the title scrolls (the bar shows only then), and the control
// that has the keyboard focus is kept in view.
component Page inherits Rectangle {
    property <int> focus-seen: Reveal.count;

    changed focus-seen => {
        if scroll.content-height > scroll.visible-height {
            let top = Reveal.y - scroll.absolute-position.y;
            let bottom = top + Reveal.height;
            if top < Grid.margin-y {
                scroll.content-y = Math.min(0px, scroll.content-y + Grid.margin-y - top);
            } else if bottom > scroll.visible-height - Grid.margin-y {
                scroll.content-y = Math.max(scroll.visible-height - scroll.content-height, scroll.content-y - (bottom - scroll.visible-height + Grid.margin-y));
            }
        }
    }

    scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: scroll.visible-width;
            padding-left: Grid.margin-x;
            padding-right: Grid.margin-x;
            padding-top: Grid.margin-y;
            padding-bottom: Grid.margin-y;
            spacing: Grid.group-gap;
            alignment: start;

            @children
        }
    }
}

// The title of a page, and what goes with it on the right.
component PageTitle inherits HorizontalLayout {
    in property <string> text;
    height: 32px;
    spacing: 8px;

    Text {
        text: root.text;
        font-size: Type.title;
        font-weight: 600;
        color: Surface.text;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    @children
}

export component OutputPage inherits Page {
    PageTitle {
        text: @tr("ui" => "Output");

        FluentButton {
            text: @tr("ui" => "Apply recommended");
            tip: @tr("ui" => "Balanced mode, microphone boost 6, noise reduction on, AGC and sidetone off.");
            subtle: true;
            enabled: Model.controls-enabled;
            clicked => {
                Model.apply-recommended();
            }
        }
    }

    ModeGroup { }

    Group {
        Row {
            icon: "\u{E767}";
            muted-icon: "\u{E74F}";
            mute-text: @tr("ui" => "Mute speakers");
            unmute-text: @tr("ui" => "Unmute speakers");
            muted <=> Model.speaker-muted;
            title: @tr("ui" => "Speaker volume");
            value-column: true;
            value: Model.speaker-present ? @tr("ui" => "{}%", Math.round(Model.speaker-volume)) : "";
            disabled: !Model.speaker-present;
            mute-toggled(muted) => {
                Model.mute-toggled(0, muted);
            }

            AppSlider {
                minimum: 0;
                maximum: 100;
                step: 1;
                value <=> Model.speaker-volume;
                enabled: Model.speaker-present;
                label: @tr("ui" => "Speaker volume");
                description: @tr("ui" => "The Windows volume of the sound card.");
                changed(value) => {
                    Model.speaker-volume = Math.round(value);
                    Model.volume-changed(0, Math.round(value));
                }
            }
        }

        soft-start-row := Row {
            icon: "\u{E916}";
            title: @tr("ui" => "Soft-start time");
            help: @tr("ui" => "Used only by Lowest noise. After audio starts it stays muted for this time plus about 150 ms.");
            value-column: true;
            value: @tr("ui" => "{} ms", Math.round(Model.settle-ms));
            disabled: !Model.settle-enabled;

            AppSlider {
                minimum: Model.settle-min;
                maximum: Model.settle-max;
                step: Model.settle-step;
                value <=> Model.settle-ms;
                enabled: !soft-start-row.disabled;
                label: @tr("ui" => "Soft-start time");
                description: soft-start-row.help;
                changed(value) => {
                    self.value = Math.round(value / Model.settle-step) * Model.settle-step;
                    Model.settle-changed(Math.round(self.value));
                }
                released => {
                    Model.slider-released();
                }
            }
        }

        decay-row := Row {
            icon: "\u{E917}";
            title: @tr("ui" => "Release time");
            help: @tr("ui" => "Used only by Balanced. After audio or a recording stops, the output stays open for this time and then goes quiet again. Vendor setting: 800 ms.");
            value-column: true;
            value: @tr("ui" => "{} ms", Math.round(Model.decay-ms));
            disabled: !Model.decay-enabled;

            AppSlider {
                minimum: Model.decay-min;
                maximum: Model.decay-max;
                step: Model.decay-step;
                value <=> Model.decay-ms;
                enabled: !decay-row.disabled;
                label: @tr("ui" => "Release time");
                description: decay-row.help;
                changed(value) => {
                    self.value = Math.round(value / Model.decay-step) * Model.decay-step;
                    Model.decay-changed(Math.round(self.value));
                }
                released => {
                    Model.slider-released();
                }
            }
        }
    }

    Group {
        ExperimentalTag { }

        surround-row := Row {
            icon: "\u{E7F6}";
            title: @tr("ui" => "Virtual surround");
            help: @tr("ui" => "7.1 virtual surround for the headphones. The firmware applies it; how it sounds was not measured.");
            disabled: !Model.controls-enabled;

            SwitchControl {
                label: @tr("ui" => "Virtual surround");
                description: surround-row.help;
                checked <=> Model.surround;
                enabled: Model.controls-enabled;
                toggled(on) => {
                    Model.surround-toggled(on);
                }
            }
        }

        surround-level-row := Row {
            icon: "\u{E994}";
            title: @tr("ui" => "Surround level");
            help: @tr("ui" => "1 to 10, vendor setting 4. How it sounds was not measured. Changing it while audio plays reloads the codec, and a click was not ruled out.");
            value-column: true;
            value: @tr("ui" => "{}", Math.round(Model.surround-level));
            disabled: !Model.controls-enabled || !Model.surround;

            AppSlider {
                minimum: Model.surround-level-min;
                maximum: Model.surround-level-max;
                step: 1;
                value <=> Model.surround-level;
                enabled: !surround-level-row.disabled;
                label: @tr("ui" => "Surround level");
                description: surround-level-row.help;
                changed(value) => {
                    self.value = Math.round(value);
                    Model.surround-level-changed(Math.round(self.value));
                }
                released => {
                    Model.slider-released();
                }
            }
        }
    }
}

export component MicrophonePage inherits Page {
    PageTitle {
        text: @tr("ui" => "Microphone");
    }

    Group {
        Row {
            icon: "\u{E720}";
            muted-icon: "\u{F781}";
            mute-text: @tr("ui" => "Mute microphone");
            unmute-text: @tr("ui" => "Unmute microphone");
            muted <=> Model.microphone-muted;
            title: @tr("ui" => "Microphone volume");
            value-column: true;
            value: Model.microphone-present ? @tr("ui" => "{}%", Math.round(Model.microphone-volume)) : "";
            disabled: !Model.microphone-present;
            mute-toggled(muted) => {
                Model.mute-toggled(1, muted);
            }

            AppSlider {
                minimum: 0;
                maximum: 100;
                step: 1;
                value <=> Model.microphone-volume;
                enabled: Model.microphone-present;
                label: @tr("ui" => "Microphone volume");
                description: @tr("ui" => "The Windows volume of the microphone.");
                changed(value) => {
                    Model.microphone-volume = Math.round(value);
                    Model.volume-changed(1, Math.round(value));
                }
            }
        }

        boost-row := Row {
            icon: "\u{E9E9}";
            title: @tr("ui" => "Microphone boost");
            help: @tr("ui" => "Relative to the vendor setting, step 4; a step is 6 dB. Step 6 had the best signal-to-noise ratio in one take, step 7 added 6 dB of noise.");
            value-column: true;
            value: Texts.gain(Model.boost-db);
            disabled: !Model.controls-enabled;

            AppSlider {
                minimum: 0;
                maximum: Model.boost-max;
                step: 1;
                value <=> Model.boost;
                enabled: Model.controls-enabled;
                label: @tr("ui" => "Microphone boost");
                description: boost-row.help;
                changed(value) => {
                    self.value = Math.round(value);
                    Model.boost-changed(Math.round(value));
                }
                released => {
                    Model.slider-released();
                }
            }
        }

        noise-reduction-row := Row {
            icon: "\u{E9D2}";
            title: @tr("ui" => "Noise reduction");
            help: @tr("ui" => "Suppresses steady background noise. Measured: about 12 dB less. The effect on speech was not measured.");
            disabled: !Model.controls-enabled;

            SwitchControl {
                label: @tr("ui" => "Noise reduction");
                description: noise-reduction-row.help;
                checked <=> Model.noise-reduction;
                enabled: Model.controls-enabled;
                toggled(on) => {
                    Model.noise-reduction-toggled(on);
                }
            }
        }
    }

    Group {
        ExperimentalTag { }

        agc-row := Row {
            icon: "\u{E9D9}";
            title: @tr("ui" => "AGC");
            help: @tr("ui" => "Automatic gain control. The firmware applies it; a measurement found no effect on steady noise, and speech was not tested.");
            disabled: !Model.controls-enabled;

            SwitchControl {
                label: @tr("ui" => "AGC");
                description: agc-row.help;
                checked <=> Model.agc;
                enabled: Model.controls-enabled;
                toggled(on) => {
                    Model.agc-toggled(on);
                }
            }
        }
    }

    if Model.mode == 2: InfoBar {
        text: @tr("ui" => "Balanced: opening the microphone from idle gives 1.26 s of silence and a click.");
    }
}

export component SidetonePage inherits Page {
    PageTitle {
        text: @tr("ui" => "Sidetone");
    }

    Group {
        ExperimentalTag { }

        sidetone-row := Row {
            icon: "\u{E95B}";
            title: @tr("ui" => "Sidetone");
            help: @tr("ui" => "Plays your microphone in the headphones while a microphone and playback are open.");
            disabled: !Model.controls-enabled;

            SwitchControl {
                label: @tr("ui" => "Sidetone");
                description: sidetone-row.help;
                checked <=> Model.sidetone;
                enabled: Model.controls-enabled;
                toggled(on) => {
                    Model.sidetone-toggled(on);
                }
            }
        }

        level-row := Row {
            icon: "\u{E767}";
            title: @tr("ui" => "Sidetone level");
            help: @tr("ui" => "In dB as the ROM counts it (USB audio class, 1/256 dB; 0 to +16 dB). The dongle does not expose this control to Windows, and the loudness was never measured. Vendor default: +3.7 dB.");
            value-column: true;
            value: Texts.level-db(Math.round(Model.level));
            disabled: !Model.controls-enabled || !Model.sidetone;

            AppSlider {
                minimum: Model.level-min;
                maximum: Model.level-max;
                step: Model.level-step;
                value <=> Model.level;
                enabled: !level-row.disabled;
                label: @tr("ui" => "Sidetone level");
                description: level-row.help;
                changed(value) => {
                    Model.level-changed(value);
                }
                released => {
                    Model.slider-released();
                }
            }
        }
    }

    InfoBar {
        icon: "\u{E7BA}";
        tone: Surface.caution;
        text: @tr("ui" => "Keep Windows' \"Listen to this device\" off for the microphone: it would echo.");
    }
}

// A row that opens another page.
component PageLink inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    callback clicked();
    height: Grid.row;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => {
        root.clicked();
    }

    Row {
        icon: root.icon;
        title: root.title;
        hovered: touch.has-hover;

        // the ink of the chevron ends at the edge of the control, like the other controls
        Rectangle {
            width: 16px;
            height: 16px;

            Icon {
                x: 3px;
                text: "\u{E76C}";
                font-size: Type.chevron;
                color: Surface.secondary;
                width: 16px;
                horizontal-alignment: right;
            }
        }
    }

    if keys.has-focus: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Surface.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    keys := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// What a test shows in its row, before the button: how far it is while it runs, else what it
// measured last.
component TestResultText inherits ResultText {
    in property <TestJob> job;
    // the test of the same row that runs after this one
    in property <bool> with-play;
    in property <Measured> result;
    property <bool> running: Model.test-job == root.job || (root.with-play && Model.test-job == TestJob.play);
    text: root.running ? Texts.progress(Model.test-step, Model.test-remaining) : root.result.present ? Texts.measured-text(root.job, root.result) : "";
    detail: !root.running && root.result.present ? Texts.measured-detail(root.job, root.result) : "";
    subdued: root.running;
}

export component TestPage inherits Page {
    PageTitle {
        text: @tr("ui" => "Test");
    }

    if Model.test-problem != TestProblem.none: InfoBar {
        icon: "\u{E783}";
        tone: Surface.critical;
        text: Texts.test-problem(Model.test-problem);
    }

    Group {
        level-row := Row {
            icon: "\u{E720}";
            title: @tr("ui" => "Level");
            help: @tr("ui" => "The RMS level of the last 50 ms in dBFS, where 0 is digital full scale. The microphone is open only while this page is shown.");
            disabled: !Model.controls-enabled;

            HorizontalLayout {
                LevelBar {
                    segments: 10;
                    active: Model.meters-active;
                    db: Model.mic-db;
                    label: @tr("ui" => "Level");
                }

                ResultText {
                    text: Model.meters-active ? Texts.dbfs-rounded(Model.mic-db) : "";
                }
            }

            // nothing to press: the control is left out
            Rectangle {
                width: Grid.control;
                horizontal-stretch: 0;
            }
        }

        noise-floor-row := Row {
            icon: "\u{E9D2}";
            title: @tr("ui" => "Noise floor");
            help: @tr("ui" => "The median level over {} s, after the microphone has warmed up. Keep the room quiet.", Model.noise-floor-seconds);
            disabled: !Model.controls-enabled;

            TestResultText {
                job: TestJob.noise-floor;
                result: Model.noise-floor-result;
            }

            TestButton {
                width: Grid.control;
                job: TestJob.noise-floor;
                start-text: @tr("ui" => "Measure");
            }
        }

        recording-row := Row {
            icon: "\u{E7C8}";
            title: @tr("ui" => "Recording");
            help: @tr("ui" => "Records {} s from the microphone into memory; nothing is saved. The level is the RMS and, under it, the peak, in dBFS. Play sends it to the headset, scaled down if its peak is above -12 dBFS.", Model.record-seconds);
            disabled: !Model.controls-enabled;

            TestResultText {
                job: TestJob.record;
                with-play: true;
                result: Model.recording-result;
            }

            HorizontalLayout {
                width: Grid.control;
                spacing: Grid.value-gap;

                TestButton {
                    width: Grid.half-control;
                    pad: 4px;
                    job: TestJob.record;
                    start-text: @tr("ui" => "Record {} s", Model.record-seconds);
                }

                TestButton {
                    width: Grid.half-control;
                    pad: 4px;
                    job: TestJob.play;
                    start-text: @tr("ui" => "Play");
                    available: Model.test-has-recording;
                }
            }
        }
    }

    Group {
        comparison-row := Row {
            icon: "\u{E8AB}";
            title: @tr("ui" => "Noise reduction");
            help: @tr("ui" => "Measures the noise floor for {} s with noise reduction on and for {} s with it off, then puts the setting back. The result is the change, and under it the level with the setting on and off.", Model.comparison-seconds, Model.comparison-seconds);
            disabled: !Model.controls-enabled;

            TestResultText {
                job: TestJob.comparison;
                result: Model.comparison-result;
            }

            TestButton {
                width: Grid.control;
                job: TestJob.comparison;
                start-text: @tr("ui" => "Compare");
            }
        }
    }

    if Model.test-caution: InfoBar {
        icon: "\u{E7BA}";
        tone: Surface.caution;
        text: @tr("ui" => "Low-level test sound plays in the headset.");
    }

    Group {
        click-row := Row {
            icon: "\u{E945}";
            title: @tr("ui" => "Click test");
            help: @tr("ui" => "Waits until the output is idle, then plays a short tone at -40 dBFS, so that the click at its start and its end can be heard.");
            disabled: !Model.controls-enabled;

            TestResultText {
                job: TestJob.click;
                result: Model.click-result;
            }

            TestButton {
                width: Grid.control;
                job: TestJob.click;
                start-text: @tr("ui" => "Play");
            }
        }

        listen-row := Row {
            icon: "\u{E995}";
            title: @tr("ui" => "Listen to noise");
            help: @tr("ui" => "Closes the microphone and waits until the output is idle, so that you can listen to its noise in the headset. Nothing is played.");
            disabled: !Model.controls-enabled;

            TestResultText {
                job: TestJob.listen;
                result: Model.listen-result;
            }

            TestButton {
                width: Grid.control;
                job: TestJob.listen;
                start-text: @tr("ui" => "Start");
            }
        }
    }
}

export component GeneralPage inherits Page {
    PageTitle {
        text: @tr("ui" => "General");
    }

    Group {
        autostart-row := Row {
            icon: "\u{E7E8}";
            title: @tr("ui" => "Start with Windows");
            help: @tr("ui" => "Starts minimized in the notification area when you sign in; nothing is installed.");

            SwitchControl {
                label: @tr("ui" => "Start with Windows");
                description: autostart-row.help;
                checked <=> Model.autostart;
                toggled(on) => {
                    Model.autostart-toggled(on);
                }
            }
        }

        Row {
            icon: "\u{E775}";
            title: @tr("ui" => "Language");

            VerticalLayout {
                ComboBox {
                    width: Grid.control;
                    model: ["Türkçe", "English"];
                    current-index <=> Model.language;
                    accessible-label: @tr("ui" => "Language");
                    selected(value) => {
                        Model.language-selected(self.current-index);
                    }
                }
            }
        }

        Row {
            icon: "\u{E838}";
            title: @tr("ui" => "Log");

            VerticalLayout {
                FluentButton {
                    min-width: Grid.control;
                    text: @tr("ui" => "Open log folder");
                    tip: @tr("ui" => "Technical details of what cxtune did.");
                    clicked => {
                        Model.open-log-folder();
                    }
                }
            }
        }
    }

    if Model.autostart-failed: InfoBar {
        icon: "\u{E783}";
        tone: Surface.critical;
        text: @tr("ui" => "The setting could not be changed.");
    }

    PageLink {
        icon: "\u{E946}";
        title: @tr("ui" => "About");
        clicked => {
            Model.tab = 5;
        }
    }
}

export component AboutPage inherits Page {
    Breadcrumb {
        parent: @tr("ui" => "General");
        current: @tr("ui" => "About");
        back => {
            Model.tab = 4;
        }
    }

    VerticalLayout {
        spacing: Grid.gap;

        HorizontalLayout {
            alignment: center;
            DeviceTile {
                width: 160px;
                height: 96px;
                inset: 6px;
                source: @image-url("../assets/dongle.png");
                label: @tr("ui" => "HyperX Cloud II USB sound card");
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: "cxtune";
                color: Surface.text;
                font-size: Type.device;
                font-weight: 600;
            }
        }

        HorizontalLayout {
            alignment: center;
            Caption {
                text: @tr("ui" => "Version {} · MIT license", Model.version);
            }
        }
    }

    Card {
        VerticalLayout {
            spacing: 2px;

            for line in 4: HorizontalLayout {
                spacing: 8px;

                Body {
                    text: "•";
                    width: 8px;
                }

                Body {
                    text: Texts.about-line(line);
                    overflow: elide;
                }
            }
        }
    }
}
