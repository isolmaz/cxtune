import { Palette } from "std-widgets.slint";

// Development only: lets the screenshots show both colour schemes.
export global Theme {
    in-out property <ColorScheme> scheme <=> Palette.color-scheme;
}

// The compact Windows 11 dialog: a lighter content layer over a darker page and footer band,
// on a grid of 96-DPI pixels.
export global Grid {
    out property <length> width: 480px;
    out property <length> tab-bar: 48px;
    out property <length> content: 240px;
    out property <length> footer: 60px;
    out property <length> height: tab-bar + content + footer;
    out property <length> margin: 20px;
    // the control column starts at 170px: the margin plus this
    out property <length> label: 150px;
    out property <length> row: 30px;
    out property <length> gap: 6px;
    out property <length> button: 130px;
}

export global Surface {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> page: dark ? #202020 : #F3F3F3;
    out property <color> card: dark ? #2B2B2B : #FBFBFB;
    out property <color> stroke: dark ? #3A3A3A : #E5E5E5;
    out property <color> text: dark ? #FFFFFF : #1A1A1A;
    out property <color> quiet: dark ? #C5C5C5 : #5D5D5D;
    out property <color> critical: dark ? #FF99A4 : #C42B1C;
    out property <color> good: dark ? #6CCB5F : #0F7B0F;
    out property <color> caution: dark ? #FCE100 : #9D5D00;
    // the box of an explanation
    out property <color> popup: dark ? #383838 : #FFFFFF;
}
