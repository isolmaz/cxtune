import { Model, Title } from "contract.slint";
import { Caption, DeviceTile, FluentButton, Hover, LinkText, MeterRow, Nav, StatusPill, CardTitle } from "components.slint";
import { AboutPage, GeneralPage, MicrophonePage, OutputPage, SidetonePage } from "pages.slint";
import { Grid, Signal, Surface, Type } from "theme.slint";
import { Texts } from "texts.slint";

export * from "contract.slint";
export { Texts } from "texts.slint";

component Header inherits Rectangle {
    background: Surface.layer;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Surface.stroke;
    }

    HorizontalLayout {
        padding-left: Grid.margin;
        padding-right: Grid.margin;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            DeviceTile {
                width: 48px;
                height: 48px;
                inset: 3px;
                source: @image-url("../assets/dongle.png");
                clip-x: 138;
                clip-y: 12;
                clip-width: 82;
                clip-height: 78;
                label: @tr("ui" => "HyperX Cloud II USB sound card");
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: "HyperX Cloud II";
                color: Surface.text;
                font-size: Type.device;
                font-weight: 600;
                height: 22px;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                StatusPill {
                    text: Texts.pill(Model.title);
                    tone: Signal.tone(Model.tone);
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Caption {
                        text: @tr("ui" => "USB sound card");
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;
            horizontal-stretch: 0;

            MeterRow {
                tag: "OUT";
                label: @tr("ui" => "Output level");
                active: Model.meters-active;
                db: Model.out-db;
            }

            MeterRow {
                tag: "MIC";
                label: @tr("ui" => "Microphone level");
                active: Model.meters-active;
                db: Model.mic-db;
            }
        }
    }
}

component Footer inherits Rectangle {
    background: Surface.layer;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Surface.stroke;
    }

    HorizontalLayout {
        padding-left: Grid.margin;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Signal.tone(Model.tone);
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            CardTitle {
                text: Texts.title(Model.title);
                overflow: elide;
                height: 20px;
            }

            if Texts.hint(Model.hint) != "": Caption {
                text: Texts.hint(Model.hint);
                overflow: elide;
                height: 16px;
            }
        }

        if Model.details: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            LinkText {
                text: @tr("ui" => "Open log");
                clicked => {
                    Model.open-log-folder();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            FluentButton {
                text: @tr("ui" => "Re-apply");
                icon: "\u{E72C}";
                button-height: 32px;
                enabled: Model.reapply-enabled;
                clicked => {
                    Model.reapply();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "cxtune";
    icon: @image-url("../assets/window.png");
    background: Surface.window;
    default-font-family: "Segoe UI";
    default-font-size: Type.body;
    preferred-width: Grid.width;
    preferred-height: Grid.height;
    min-width: Grid.width;
    max-width: Grid.width;
    min-height: Grid.height;
    max-height: Grid.height;

    VerticalLayout {
        Header {
            height: Grid.header;
        }

        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: Grid.nav;
                background: Surface.layer;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Surface.stroke;
                }

                Nav {
                    icons: ["\u{E767}", "\u{E720}", "\u{E95B}", "\u{E713}"];
                    names: [@tr("ui" => "Output"), @tr("ui" => "Microphone"), @tr("ui" => "Sidetone"), @tr("ui" => "General")];
                    // the About page belongs to General
                    selected: Model.tab == 4 ? 3 : Model.tab;
                    chosen(page) => {
                        Model.tab = page;
                    }
                }

                Caption {
                    x: 16px;
                    y: parent.height - 28px;
                    width: parent.width - 32px;
                    height: 16px;
                    text: @tr("ui" => "cxtune {}", Model.version);
                    color: Surface.secondary;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                if Model.tab == 0: OutputPage { }
                if Model.tab == 1: MicrophonePage { }
                if Model.tab == 2: SidetonePage { }
                if Model.tab == 3: GeneralPage { }
                if Model.tab == 4: AboutPage { }
            }
        }

        Footer {
            height: Grid.footer;
        }
    }

    // above everything else
    if Hover.explanation != "": Rectangle {
        property <length> text-width: Math.min(measure.preferred-width, 460px);
        property <length> tip-height: tip.preferred-height + 16px;
        width: text-width + 24px;
        height: tip-height;
        x: Math.clamp(Hover.x - 8px, 8px, Grid.width - self.width - 8px);
        y: Hover.y + 8px + tip-height > Grid.height - 4px ? Hover.y - 16px - 8px - tip-height : Hover.y + 8px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Surface.stroke-strong;
        background: Surface.popup;

        measure := Text {
            text: Hover.explanation;
            font-size: Type.caption;
            visible: false;
        }

        tip := Text {
            text: Hover.explanation;
            color: Surface.text;
            font-size: Type.caption;
            wrap: word-wrap;
            x: 12px;
            y: 8px;
            width: parent.text-width;
            accessible-role: none;
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <Title> status-title: Title.starting;
    // the mode that is chosen, and whether the engine can change it
    in property <int> mode;
    in property <bool> controls-enabled;
    in property <bool> reapply-enabled;
    icon: @image-url("../assets/tray.png");
    tooltip: @tr("ui" => "cxtune: {}", Texts.title(root.status-title));

    callback show-requested();
    callback about-requested();
    callback mode-requested(int);
    callback reapply-requested();
    callback quit-requested();
    // `tooltip` and `clicked` are not part of the Rust API of the tray icon, so they are forwarded.
    callback icon-clicked();
    clicked => {
        root.icon-clicked();
    }

    // The menu of the tray icon has no check marks, so the mode that is chosen carries a filled
    // circle and the others an empty one.
    Menu {
        MenuItem {
            title: @tr("ui" => "Show");
            activated => {
                root.show-requested();
            }
        }

        MenuSeparator {}

        MenuItem {
            title: (root.mode == 0 ? "● " : "○ ") + Texts.mode-name(0);
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(0);
            }
        }

        MenuItem {
            title: (root.mode == 1 ? "● " : "○ ") + Texts.mode-name(1);
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(1);
            }
        }

        MenuItem {
            title: (root.mode == 2 ? "● " : "○ ") + Texts.mode-name(2);
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(2);
            }
        }

        MenuItem {
            title: (root.mode == 3 ? "● " : "○ ") + Texts.mode-name(3);
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(3);
            }
        }

        MenuSeparator {}

        MenuItem {
            title: @tr("ui" => "Re-apply");
            enabled: root.reapply-enabled;
            activated => {
                root.reapply-requested();
            }
        }

        MenuItem {
            title: @tr("ui" => "About");
            activated => {
                root.about-requested();
            }
        }

        MenuItem {
            title: @tr("ui" => "Quit");
            activated => {
                root.quit-requested();
            }
        }
    }
}
