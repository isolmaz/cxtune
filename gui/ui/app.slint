import { Button } from "std-widgets.slint";
import { Hint, Model, Title, Tone } from "contract.slint";
import { LinkText, TabBar, Hover } from "components.slint";
import { AboutTab, GeneralTab, MicrophoneTab, OutputTab, SidetoneTab } from "tabs.slint";
import { Grid, Surface } from "theme.slint";
import { Texts } from "texts.slint";

export * from "contract.slint";
export { Texts } from "texts.slint";

component Footer inherits Rectangle {
    // red for a problem, amber for what is not settled, green when the dongle holds the settings
    property <color> tone: Model.tone == Tone.critical ? Surface.critical : Model.tone == Tone.caution ? Surface.caution : Surface.good;
    background: Surface.page;

    HorizontalLayout {
        padding-left: Grid.margin;
        padding-right: Grid.margin;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.tone;
                    }
                }

                Text {
                    text: Texts.title(Model.title);
                    color: Surface.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if Model.details: LinkText {
                    text: @tr("ui" => "Open log");
                    font-size: 12px;
                    clicked => {
                        Model.open-log-folder();
                    }
                }
            }

            Text {
                text: Texts.hint(Model.hint);
                color: Surface.quiet;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: Grid.button;
            Button {
                text: @tr("ui" => "Re-apply");
                enabled: Model.reapply-enabled;
                clicked => {
                    Model.reapply();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "cxtune";
    icon: @image-url("../assets/window.png");
    background: Surface.page;
    default-font-family: "Segoe UI";
    preferred-width: Grid.width;
    preferred-height: Grid.height;
    min-width: Grid.width;
    max-width: Grid.width;
    min-height: Grid.height;
    max-height: Grid.height;

    Rectangle {
        x: 0px;
        y: 0px;
        width: Grid.width;
        height: Grid.tab-bar + Grid.content;
        background: Surface.card;
    }

    Rectangle {
        x: 0px;
        y: Grid.tab-bar;
        width: Grid.width;
        height: 1px;
        background: Surface.stroke;
    }

    Rectangle {
        x: 0px;
        y: Grid.tab-bar + Grid.content;
        width: Grid.width;
        height: 1px;
        background: Surface.stroke;
    }

    TabBar {
        x: Grid.margin - 10px;
        y: 6px;
        width: Grid.width - 2 * (Grid.margin - 10px);
        names: [@tr("ui" => "Output"), @tr("ui" => "Microphone"), @tr("ui" => "Sidetone"), @tr("ui" => "General"), @tr("ui" => "About")];
    }

    Rectangle {
        x: 0px;
        y: Grid.tab-bar;
        width: Grid.width;
        height: Grid.content;
        clip: true;

        if Model.tab == 0: OutputTab { }
        if Model.tab == 1: MicrophoneTab { }
        if Model.tab == 2: SidetoneTab { }
        if Model.tab == 3: GeneralTab { }
        if Model.tab == 4: AboutTab { }
    }

    Footer {
        x: 0px;
        y: Grid.tab-bar + Grid.content;
        width: Grid.width;
        height: Grid.footer;
    }

    // above everything else
    if Hover.explanation != "": Rectangle {
        property <length> tip-height: tip.preferred-height + 14px;
        property <length> below: Hover.y + 8px;
        x: Grid.margin;
        y: below + tip-height > Grid.height - 4px ? Hover.y - 16px - 8px - tip-height : below;
        width: Grid.width - 2 * Grid.margin;
        height: tip-height;
        border-radius: 6px;
        border-width: 1px;
        border-color: Surface.quiet.with-alpha(0.5);
        background: Surface.popup;

        tip := Text {
            text: Hover.explanation;
            color: Surface.text;
            font-size: 12px;
            wrap: word-wrap;
            x: 8px;
            y: 7px;
            width: parent.width - 16px;
            accessible-role: none;
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <Title> status-title: Title.starting;
    // the mode that is chosen, and whether the engine can change it
    in property <int> mode;
    in property <bool> controls-enabled;
    in property <bool> reapply-enabled;
    icon: @image-url("../assets/tray.png");
    tooltip: @tr("ui" => "cxtune: {}", Texts.title(root.status-title));

    callback show-requested();
    callback about-requested();
    callback mode-requested(int);
    callback reapply-requested();
    callback quit-requested();
    // `tooltip` and `clicked` are not part of the Rust API of the tray icon, so they are forwarded.
    callback icon-clicked();
    clicked => {
        root.icon-clicked();
    }

    // The menu of the tray icon has no check marks, so the mode that is chosen carries a filled
    // circle and the others an empty one.
    Menu {
        MenuItem {
            title: @tr("ui" => "Show");
            activated => {
                root.show-requested();
            }
        }

        MenuSeparator {}

        MenuItem {
            title: (root.mode == 0 ? "● " : "○ ") + @tr("ui" => "Stock");
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(0);
            }
        }

        MenuItem {
            title: (root.mode == 1 ? "● " : "○ ") + @tr("ui" => "Quiet start");
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(1);
            }
        }

        MenuItem {
            title: (root.mode == 2 ? "● " : "○ ") + @tr("ui" => "Balanced");
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(2);
            }
        }

        MenuItem {
            title: (root.mode == 3 ? "● " : "○ ") + @tr("ui" => "Minimum hiss");
            enabled: root.controls-enabled;
            activated => {
                root.mode-requested(3);
            }
        }

        MenuSeparator {}

        MenuItem {
            title: @tr("ui" => "Re-apply");
            enabled: root.reapply-enabled;
            activated => {
                root.reapply-requested();
            }
        }

        MenuItem {
            title: @tr("ui" => "About");
            activated => {
                root.about-requested();
            }
        }

        MenuItem {
            title: @tr("ui" => "Quit");
            activated => {
                root.quit-requested();
            }
        }
    }
}
