import { Click, Hint, Measured, NoiseFloor, StartDelay, TestJob, TestProblem, TestStep, Title } from "contract.slint";

// The texts of the contract's enums, in the language that is selected. This is the only place
// where the status, the indicators and the gain become words.
export global Texts {
    public pure function title(kind: Title) -> string {
        if kind == Title.starting {
            return @tr("ui" => "Starting…");
        }
        if kind == Title.disconnected {
            return @tr("ui" => "Dongle not connected");
        }
        if kind == Title.waiting {
            return @tr("ui" => "Waiting for the dongle's firmware");
        }
        if kind == Title.applying {
            return @tr("ui" => "Applying settings…");
        }
        if kind == Title.reading {
            return @tr("ui" => "Connected, reading the dongle…");
        }
        if kind == Title.in-sync {
            return @tr("ui" => "Connected, settings applied");
        }
        if kind == Title.not-applied {
            return @tr("ui" => "Connected, settings not applied");
        }
        if kind == Title.stopped {
            return @tr("ui" => "Stopped");
        }
        if kind == Title.communication {
            return @tr("ui" => "Trouble reaching the dongle");
        }
        if kind == Title.audio {
            return @tr("ui" => "Cannot open the dongle's audio");
        }
        if kind == Title.refused {
            return @tr("ui" => "The dongle was changed");
        }
        if kind == Title.unsupported-firmware {
            return @tr("ui" => "Unsupported firmware");
        }
        if kind == Title.verify {
            return @tr("ui" => "A setting did not stick");
        }
        if kind == Title.drift {
            return @tr("ui" => "Another program is interfering");
        }
        if kind == Title.unresponsive {
            return @tr("ui" => "The dongle stopped answering");
        }
        if kind == Title.fatal {
            return @tr("ui" => "cxtune stopped after an error");
        }
        if kind == Title.busy {
            return @tr("ui" => "Another cxtune holds the dongle");
        }
        if kind == Title.bad-settings-file {
            return @tr("ui" => "The settings file is unreadable");
        }
        if kind == Title.start-failed {
            return @tr("ui" => "cxtune could not start");
        }
        if kind == Title.save-failed {
            return @tr("ui" => "Settings could not be saved");
        }
        return @tr("ui" => "Something went wrong");
    }

    public pure function hint(kind: Hint) -> string {
        if kind == Hint.saved {
            return @tr("ui" => "Settings saved");
        }
        if kind == Hint.saving {
            return @tr("ui" => "Saving settings…");
        }
        if kind == Hint.check-cable {
            return @tr("ui" => "Check the cable and the USB port.");
        }
        if kind == Hint.close-audio-users {
            return @tr("ui" => "Close programs that use its audio output.");
        }
        if kind == Hint.replug-dongle {
            return @tr("ui" => "Unplug and replug the dongle.");
        }
        if kind == Hint.replug-it {
            return @tr("ui" => "Unplug and replug it.");
        }
        if kind == Hint.leave-alone {
            return @tr("ui" => "cxtune leaves this dongle alone.");
        }
        if kind == Hint.reapply-or-replug {
            return @tr("ui" => "Press Re-apply, or replug the dongle.");
        }
        if kind == Hint.close-it {
            return @tr("ui" => "Close it, then press Re-apply.");
        }
        if kind == Hint.reapply-or-restart {
            return @tr("ui" => "Press Re-apply, or restart cxtune.");
        }
        if kind == Hint.fix-file {
            return @tr("ui" => "Fix or delete it, then press Re-apply.");
        }
        if kind == Hint.reapply-retry {
            return @tr("ui" => "Press Re-apply to try again.");
        }
        if kind == Hint.check-file {
            return @tr("ui" => "Check that the file is not locked or read-only.");
        }
        if kind == Hint.see-log {
            return @tr("ui" => "Something unusual happened. See the log.");
        }
        return "";
    }

    // the short state of the dongle in the header
    public pure function pill(kind: Title) -> string {
        if kind == Title.starting {
            return @tr("ui" => "Starting…");
        }
        if kind == Title.disconnected {
            return @tr("ui" => "Not connected");
        }
        if kind == Title.waiting {
            return @tr("ui" => "Waiting for firmware");
        }
        if kind == Title.applying {
            return @tr("ui" => "Connected · Applying");
        }
        if kind == Title.reading {
            return @tr("ui" => "Connected · Reading");
        }
        if kind == Title.in-sync {
            return @tr("ui" => "Connected · In sync");
        }
        if kind == Title.not-applied {
            return @tr("ui" => "Connected · Not in sync");
        }
        if kind == Title.stopped {
            return @tr("ui" => "Stopped");
        }
        return @tr("ui" => "Needs attention");
    }

    public pure function mode-name(mode: int) -> string {
        if mode == 0 {
            return @tr("ui" => "Default");
        }
        if mode == 1 {
            return @tr("ui" => "Low click");
        }
        if mode == 2 {
            return @tr("ui" => "Balanced");
        }
        return @tr("ui" => "Lowest noise");
    }

    public pure function noise-floor(kind: NoiseFloor) -> string {
        if kind == NoiseFloor.constant {
            return @tr("ui" => "Constant");
        }
        if kind == NoiseFloor.some {
            return @tr("ui" => "Some");
        }
        return @tr("ui" => "Reduced");
    }

    public pure function click(kind: Click) -> string {
        if kind == Click.none {
            return @tr("ui" => "None");
        }
        if kind == Click.low {
            return @tr("ui" => "Low");
        }
        if kind == Click.not-measured {
            return "—";
        }
        return @tr("ui" => "Loud");
    }

    // the value of the click as a screen reader says it
    public pure function click-spoken(kind: Click) -> string {
        return kind == Click.not-measured ? @tr("ui" => "Not measured") : click(kind);
    }

    // what the legend says about a trait of the modes, by position on the cards
    public pure function trait-tip(position: int) -> string {
        if position == 0 {
            return @tr("ui" => "Noise floor: the hiss in the headphones while nothing plays.");
        }
        if position == 1 {
            return @tr("ui" => "Click: the pop when audio starts.");
        }
        return @tr("ui" => "Start delay: how long the start of audio is muted.");
    }

    public pure function click-tip(kind: Click) -> string {
        return kind == Click.not-measured ? trait-tip(1) + " " + @tr("ui" => "Not measured yet.") : trait-tip(1);
    }

    public pure function start-delay-tip(kind: StartDelay, ms: int) -> string {
        if kind == StartDelay.fixed {
            return trait-tip(2) + " " + @tr("ui" => "The first {} ms of audio after idle is muted.", ms);
        }
        if kind == StartDelay.settle {
            return trait-tip(2) + " " + @tr("ui" => "Muted for the soft-start time plus about 150 ms.");
        }
        return trait-tip(2);
    }

    public pure function start-delay(kind: StartDelay, ms: int) -> string {
        if kind == StartDelay.none {
            return @tr("ui" => "None");
        }
        return @tr("ui" => "≈ {} ms", ms);
    }

    // The pill of the header says how the dongle stands; the footer is for what is going on and for
    // what needs an action.
    pure function calm(kind: Title) -> bool {
        return kind == Title.in-sync || kind == Title.disconnected || kind == Title.waiting || kind == Title.stopped;
    }

    public pure function footer-headline(kind: Title, advice: Hint) -> string {
        if calm(kind) {
            return advice == Hint.see-log ? hint(advice) : "";
        }
        return title(kind);
    }

    public pure function footer-detail(kind: Title, advice: Hint) -> string {
        if calm(kind) || advice == Hint.saved {
            return "";
        }
        return hint(advice);
    }

    public pure function state(on: bool) -> string {
        return on ? @tr("ui" => "On") : @tr("ui" => "Off");
    }

    public pure function gain(db: int) -> string {
        if db > 0 {
            return @tr("ui" => "+{} dB", db);
        }
        return @tr("ui" => "{} dB", db);
    }

    // the lines of the About card: what it is made for, what it is not, what it does and who bears
    // the risk
    public pure function about-line(position: int) -> string {
        if position == 0 {
            return @tr("ui" => "Made for the HyperX Cloud II USB sound card (USB 0951:16A4).");
        }
        if position == 1 {
            return @tr("ui" => "Not affiliated with HyperX, HP or Synaptics.");
        }
        if position == 2 {
            return @tr("ui" => "Changes live in RAM only; unplugging restores the vendor settings.");
        }
        return @tr("ui" => "Use at your own risk. The authors accept no liability.");
    }

    // the sidetone gain register counts 1/256 dB, as the ROM's USB audio code does; the tenths are
    // formatted separately so that the Turkish text can use a decimal comma
    public pure function level-db(register: int) -> string {
        let tenths = Math.round(register / 25.6);
        if tenths <= 0 {
            return @tr("ui" => "{} dB", 0);
        }
        return @tr("ui" => "+{}.{} dB", Math.floor(tenths / 10), Math.mod(tenths, 10));
    }

    // ---- the Test page ----

    // a measured number with one decimal and its sign; the Turkish text uses a decimal comma
    public pure function number(value: float) -> string {
        let tenths = Math.round(Math.abs(value) * 10);
        if value < 0 && tenths > 0 {
            return @tr("ui" => "-{}.{}", Math.floor(tenths / 10), Math.mod(tenths, 10));
        }
        return @tr("ui" => "{}.{}", Math.floor(tenths / 10), Math.mod(tenths, 10));
    }

    public pure function dbfs(value: float) -> string {
        return @tr("ui" => "{} dBFS", number(value));
    }

    // the level of the meter, whole dB
    public pure function dbfs-rounded(value: float) -> string {
        return @tr("ui" => "{} dBFS", Math.round(value));
    }

    // what noise reduction changes in the noise floor, in dB
    public pure function db-change(value: float) -> string {
        if value > 0 && Math.round(value * 10) > 0 {
            return @tr("ui" => "+{} dB", number(value));
        }
        return @tr("ui" => "{} dB", number(value));
    }

    public pure function seconds(ms: int) -> string {
        return @tr("ui" => "{} s", number(ms / 1000));
    }

    public pure function step(kind: TestStep) -> string {
        if kind == TestStep.warming-up {
            return @tr("ui" => "Warming up");
        }
        if kind == TestStep.measuring {
            return @tr("ui" => "Measuring");
        }
        if kind == TestStep.recording {
            return @tr("step" => "Recording");
        }
        if kind == TestStep.with-noise-reduction {
            return @tr("ui" => "Reduction on");
        }
        if kind == TestStep.switching {
            return @tr("ui" => "Switching");
        }
        if kind == TestStep.without-noise-reduction {
            return @tr("ui" => "Reduction off");
        }
        if kind == TestStep.waiting {
            return @tr("ui" => "Waiting");
        }
        if kind == TestStep.resting {
            return @tr("ui" => "Pausing");
        }
        return @tr("ui" => "Playing");
    }

    // a running test: its step and, when the step ends by itself at a known time, the seconds left
    public pure function progress(kind: TestStep, remaining: int) -> string {
        if remaining < 0 {
            return step(kind);
        }
        return @tr("ui" => "{} · {}", step(kind), @tr("ui" => "{} s", Math.ceil(remaining / 1000)));
    }

    // what a test measured: the value, and under it what else was measured
    public pure function measured-text(job: TestJob, result: Measured) -> string {
        if job == TestJob.noise-floor || job == TestJob.record {
            return dbfs(result.first);
        }
        if job == TestJob.comparison {
            return db-change(result.first);
        }
        if job == TestJob.click || job == TestJob.listen {
            return @tr("ui" => "Idle after {}", seconds(result.first));
        }
        return "";
    }

    public pure function measured-detail(job: TestJob, result: Measured) -> string {
        if job == TestJob.record {
            return @tr("ui" => "peak {}", dbfs(result.second));
        }
        if job == TestJob.comparison {
            return @tr("ui" => "{} / {} dBFS", number(result.second), number(result.third));
        }
        return "";
    }

    public pure function test-problem(kind: TestProblem) -> string {
        if kind == TestProblem.communication {
            return @tr("ui" => "The test could not reach the dongle. Check the cable and the USB port.");
        }
        if kind == TestProblem.audio {
            return @tr("ui" => "The test could not open the dongle's audio. Close programs that use it.");
        }
        return @tr("ui" => "The test stopped. The log has the details.");
    }
}
