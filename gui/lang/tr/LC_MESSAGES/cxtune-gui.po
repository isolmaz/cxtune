msgstr "Azaltılmış"

msgctxt "ui"
msgid "None"
msgstr "Yok"

msgctxt "ui"
msgid "Low"
msgstr "Düşük"

msgctxt "ui"
msgid "Loud"
msgstr "Yüksek"

msgctxt "ui"
msgid "Noise floor: the hiss in the headphones while nothing plays."
msgstr "Gürültü tabanı: hiçbir şey çalmazken kulaklıktaki fısıltı."

msgctxt "ui"
msgid "Click: the pop when audio starts."
msgstr "Tık: ses başlarken duyulan çıtlama."

msgctxt "ui"
msgid "Mute delay: how long the start of audio is muted."
msgstr "Açılış gecikmesi: sesin başlangıcının ne kadar susturulduğu."

msgctxt "ui"
msgid "Not measured yet."
msgstr "Henüz ölçülmedi."

msgctxt "ui"
msgid "The first 0.6 s of audio after idle is muted."
msgstr "Boştan sonra sesin ilk 0,6 sn'si susturulur."

msgctxt "ui"
msgid "Muted for the soft-start time plus 100 ms."
msgstr "Yumuşak açılış süresi artı 100 ms boyunca susturulur."

msgctxt "ui"
msgid "≈ 0.6 s"
msgstr "≈ 0,6 sn"

msgctxt "ui"
msgid "≈ {} ms"
msgstr "≈ {} ms"

msgctxt "ui"
msgid "On"
msgstr "Açık"

msgctxt "ui"
msgid "Off"
msgstr "Kapalı"

