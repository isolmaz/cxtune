msgid "+{} dB"
msgstr "+{} dB"

msgctxt "ui"
msgid "Made for the HyperX Cloud II USB sound card (USB 0951:16A4)."
msgstr "HyperX Cloud II USB ses kartı için yapılmıştır (USB 0951:16A4)."

msgctxt "ui"
msgid "Not affiliated with HyperX, HP or Synaptics."
msgstr "HyperX, HP veya Synaptics ile bağlantılı değildir."

msgctxt "ui"
msgid "Changes live in RAM only; unplugging restores the vendor settings."
msgstr "Değişiklikler yalnızca RAM'de; cihazı çıkarınca üretici ayarları döner."

msgctxt "ui"
msgid "Use at your own risk. The authors accept no liability."
msgstr "Kullanım riski size aittir; yazarlar sorumluluk kabul etmez."

