msgid "Trouble reaching the dongle"
msgstr "USB ses kartına ulaşılamıyor"

msgctxt "ui"
msgid "Cannot open the dongle's audio"
msgstr "USB ses kartının sesi açılamıyor"

msgctxt "ui"
msgid "The dongle was changed"
msgstr "USB ses kartı değiştirilmiş"

msgctxt "ui"
msgid "Unsupported firmware"
msgstr "Desteklenmeyen bellenim"

msgctxt "ui"
msgid "A setting did not stick"
msgstr "Bir ayar kalıcı olmadı"

msgctxt "ui"
msgid "Another program is interfering"
msgstr "Başka bir program karışıyor"

msgctxt "ui"
msgid "The dongle stopped answering"
msgstr "USB ses kartı yanıt vermiyor"

msgctxt "ui"
msgid "cxtune stopped after an error"
msgstr "cxtune bir hata nedeniyle durdu"

msgctxt "ui"
msgid "Another cxtune holds the dongle"
msgstr "Başka bir cxtune kartı kullanıyor"

msgctxt "ui"
msgid "The settings file is unreadable"
msgstr "Ayar dosyası okunamıyor"

msgctxt "ui"
msgid "cxtune could not start"
msgstr "cxtune başlatılamadı"

msgctxt "ui"
msgid "Settings could not be saved"
msgstr "Ayarlar kaydedilemedi"

msgctxt "ui"
msgid "Something went wrong"
msgstr "Bir şeyler ters gitti"

msgctxt "ui"
msgid "Settings saved"
msgstr "Ayarlar kaydedildi"

msgctxt "ui"
msgid "Saving settings…"
msgstr "Ayarlar kaydediliyor…"

msgctxt "ui"
msgid "Check the cable and the USB port."
msgstr "Kabloyu ve USB bağlantı noktasını kontrol edin."

msgctxt "ui"
msgid "Close programs that use its audio output."
msgstr "Ses çıkışını kullanan programları kapatın."

msgctxt "ui"
msgid "Unplug and replug the dongle."
msgstr "USB ses kartını çıkarıp yeniden takın."

msgctxt "ui"
msgid "Unplug and replug it."
msgstr "Çıkarıp yeniden takın."

msgctxt "ui"
msgid "cxtune leaves this dongle alone."
msgstr "cxtune bu karta dokunmaz."

msgctxt "ui"
msgid "Press Re-apply, or replug the dongle."
msgstr "Yeniden uygula'ya basın veya kartı çıkarıp takın."

msgctxt "ui"
msgid "Close it, then press Re-apply."
msgstr "Onu kapatın, sonra Yeniden uygula'ya basın."

msgctxt "ui"
msgid "Press Re-apply, or restart cxtune."
msgstr "Yeniden uygula'ya basın veya cxtune'u yeniden açın."

msgctxt "ui"
msgid "Fix or delete it, then press Re-apply."
msgstr "Düzeltin ya da silin, sonra Yeniden uygula'ya basın."

msgctxt "ui"
msgid "Press Re-apply to try again."
msgstr "Yeniden denemek için Yeniden uygula'ya basın."

msgctxt "ui"
msgid "Check that the file is not locked or read-only."
msgstr "Dosyanın kilitli veya salt okunur olmadığına bakın."

msgctxt "ui"
msgid "Something unusual happened. See the log."
msgstr "Olağandışı bir şey oldu. Günlüğe bakın."

