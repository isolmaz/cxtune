msgctxt "ui"
msgid "Noise floor: the hiss in the headphones while nothing plays."
msgstr "Gürültü tabanı: hiçbir şey çalmazken kulaklıktaki fısıltı."

msgctxt "ui"
msgid "Click: the pop when audio starts."
msgstr "Tık: ses başlarken duyulan çıtlama."

msgctxt "ui"
msgid "Start delay: how long the start of audio is muted."
msgstr "Açılış gecikmesi: sesin başlangıcının ne kadar susturulduğu."

msgctxt "ui"
