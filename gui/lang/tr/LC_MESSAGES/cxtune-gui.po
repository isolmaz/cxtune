msgid "Low click"
msgstr "Az tıklı"

msgctxt "ui"
msgid "Balanced"
msgstr "Dengeli"

msgctxt "ui"
msgid "Lowest noise"
msgstr "En düşük gürültü"

msgctxt "ui"
msgid "Constant"
msgstr "Sürekli"

msgctxt "ui"
msgid "Some"
msgstr "Biraz"

msgctxt "ui"
